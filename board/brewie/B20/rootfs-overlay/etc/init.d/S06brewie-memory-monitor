#!/bin/sh

NAME=brewie-memory-monitor
PIDFILE=/var/run/$NAME.pid

case "$1" in
  start)
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -- /usr/bin/brewie-memory-monitor --loop
    ;;
  stop)
    start-stop-daemon -K -q -p "$PIDFILE" -o 2>/dev/null || true
    rm -f "$PIDFILE"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0
