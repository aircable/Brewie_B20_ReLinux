# Brewie B20 peripherals
CONFIG_RTC_DRV_PCF8563=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_SPI_SPIDEV=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_LEDS_CLASS=y
CONFIG_RTL8XXXU=m
CONFIG_VIDEO_SUNXI_CEDRUS=y
CONFIG_SOUND=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_GPIO=y
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_PWM_SYSFS=y
# Kernel keyrings are not needed by the target; isolate late-init failure.
CONFIG_KEYS=n
